# ==============================================================================
# Shared phpBB Extension Crowdin Configuration
# ==============================================================================
#
# Values supplied by crowdin-init.sh:
#
#   CROWDIN_PROJECT_ID
#   CROWDIN_PERSONAL_TOKEN
#   CROWDIN_BASE_PATH
#
# phpBB language directory mappings are generated at runtime.
# ==============================================================================

project_id_env: CROWDIN_PROJECT_ID
api_token_env: CROWDIN_PERSONAL_TOKEN
base_path_env: CROWDIN_BASE_PATH

base_url: "https://api.crowdin.com"

preserve_hierarchy: true

files:
  - source: "/language/en/**/*.php"
    translation: "/language/%locale_with_underscore%/**/%original_file_name%"

    languages_mapping:
      locale_with_underscore:
__PHPBB_LANGUAGE_MAPPING__
